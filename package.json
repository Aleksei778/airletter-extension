{
  "name": "airletter-extension",
  "displayName": "Airletter",
  "version": "0.0.1",
  "description": "Airletter — bulk email campaigns from your own Gmail",
  "author": "aleksey_pr",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "lucide-react": "^1.48.0",
    "plasmo": "0.90.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "manifest": {
    "name": "Airletter",
    "version": "1.0",
    "description": "Airletter — bulk email campaigns from your own Gmail",
    "host_permissions": [
      "https://mail.google.com/*",
      "https://mail-attachment.googleusercontent.com/*",
      "$PLASMO_PUBLIC_SITE_URL/*"
    ],
    "permissions": [
      "identity",
      "storage"
    ]
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
