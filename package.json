  "description": "Airletter — bulk email campaigns from your own Gmail",
  "author": "aleksey_pr",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
